{
  "name": "astro-component-starter",
  "type": "module",
  "version": "1.0.2",
  "description": "A modern design system built with Astro, featuring design tokens, components, and comprehensive documentation",
  "keywords": [
    "design-system",
    "astro",
    "components",
    "css",
    "design-tokens"
  ],
  "author": "ElianisDev",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "start": "node ./dist/server/entry.mjs",
    "test": "vitest run",
    "build": "cross-env DISABLE_COMPONENT_LIBRARY=true astro build",
    "build:with-library": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "npm run lint && npm run format",
    "check:fix": "npm run lint:fix && npm run format:fix",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:yml",
    "lint:js": "eslint .",
    "lint:yml": "eslint \"**/*.{yml,yaml}\"",
    "lint:fix": "npm run lint:js:fix && npm run lint:css:fix && npm run lint:yml:fix",
    "lint:js:fix": "eslint . --fix",
    "lint:yml:fix": "eslint \"**/*.{yml,yaml}\" --fix",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "deps:sync": "rm -rf node_modules && npm install --os=linux --cpu=x64 --libc=glibc --ignore-scripts --no-audit && npm ci",
    "deps:check": "npm ci --dry-run"
  },
  "dependencies": {
    "@apphosting/astro-adapter": "^0.0.1",
    "@astrojs/compiler-rs": "^0.1.10",
    "@astrojs/markdoc": "^1.0.6",
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/node": "^10.0.6",
    "@astrojs/react": "^6.0.0",
    "@astrojs/sitemap": "^3.7.3",
    "@choctawnationofoklahoma/lite-vimeo": "^1.3.1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/raleway": "^5.2.8",
    "@justinribeiro/lite-youtube": "^1.9.0",
    "@keystatic/astro": "^5.1.0",
    "@keystatic/core": "^0.5.50",
    "@react-spectrum/provider": "3.11.1",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.1.10",
    "astro-icon": "^1.1.5",
    "astro-seo": "^1.1.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "glob": "^13.0.6",
    "js-beautify": "^1.15.4",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "markdown-it": "^14.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.34.5",
    "shiki": "^4.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.2.1",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsonc": "^3.1.2",
    "eslint-plugin-yml": "^3.3.1",
    "jsonc-eslint-parser": "^3.1.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^17.9.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^5.5.4",
    "vitest": "^4.1.9",
    "yaml-eslint-parser": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "optionalDependencies": {
    "@emnapi/core": "^1.11.1",
    "@emnapi/wasi-threads": "^1.2.2",
    "@img/sharp-linux-x64": "^0.34.5",
    "@img/sharp-linuxmusl-x64": "^0.34.5",
    "@rollup/rollup-linux-x64-gnu": "^4.60.2",
    "@rollup/rollup-win32-x64-msvc": "^4.60.2"
  },
  "overrides": {
    "vite": "^7.0.0",
    "@apphosting/astro-adapter": {
      "@astrojs/node": "$@astrojs/node"
    },
    "keyv": "^5.6.0",
    "@astrojs/markdown-remark": "^7.2.0",
    "ajv": "^8.20.0",
    "json-schema-traverse": "^1.0.0"
  }
}
