---
import { SEO } from "astro-seo";
import { resolveImageSource } from "@component-utils/resolveImageSource";

interface SiteSeoData {
  name: string;
  url: string;
  logoSource: string;
  description: string;
  titleFormat: string;
}

interface ArticleSeoData {
  publishedTime?: string | null;
  modifiedTime?: string | null;
  author?: string | string[] | null;
  tags?: string[] | null;
}

export interface Props {
  site: SiteSeoData;
  title: string;
  description?: string | null;
  keywords?: string[] | null;
  image?: string | null;
  canonical?: string | null;
  type?: "website" | "article";
  article?: ArticleSeoData | null;
  noindex?: boolean;
}

const {
  site,
  title,
  description,
  keywords,
  image,
  canonical,
  type: pageType = "website",
  article,
  noindex = false,
} = Astro.props;

const formattedTitle = site.titleFormat.replace("{title}", title);
const pageDescription = description || site.description;
const pageImage = resolveImageSource(image || site.logoSource);
const canonicalUrl = canonical || Astro.url.href;
const siteUrl = Astro.site || new URL(site.url);
const pageImageUrl = pageImage ? new URL(pageImage, siteUrl).href : undefined;
const keywordContent = keywords?.filter(Boolean).join(", ");
const articleAuthors = Array.isArray(article?.author)
  ? article.author.filter(Boolean)
  : article?.author
    ? [article.author]
    : [];
const articleTags = article?.tags?.filter(Boolean) ?? [];

const seoMeta = keywordContent ? [{ name: "keywords", content: keywordContent }] : [];
---

<SEO
  title={formattedTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  noindex={noindex}
  openGraph={{
    basic: {
      title: formattedTitle,
      type: pageType,
      image: pageImageUrl || "",
      url: canonicalUrl,
    },
    optional: {
      siteName: site.name,
      description: pageDescription,
    },
    article: pageType === "article" ? {
      publishedTime: article?.publishedTime || undefined,
      modifiedTime: article?.modifiedTime || undefined,
      authors: articleAuthors.length > 0 ? articleAuthors : undefined,
      tags: articleTags.length > 0 ? articleTags : undefined,
    } : undefined
  }}
  extend={{
    meta: seoMeta,
  }}
/>
