---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import Split from "@wrappers/split/Split.astro";

const {
  eyebrow = "",
  heading = "",
  subtext = "",
  imageSource = "",
  imageAlt = "",
  videoSource = "",
  imageAspectRatio = "none",
  buttonSections = [],
  reverse = false,
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "lg",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  backgroundColor,
  background,
  class: className,
  fixedWidth = "400",
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<CustomSection
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  background={background}
  class:list={["hero", className]}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <Split
    distributionMode="flexible-fixed"
    fixedWidth={fixedWidth}
    alignmentVertical="center"
    reverse={reverse}
    minSplitWidth={800}
    gap="2xl"
    class="hero-split"
  >
    <Fragment slot="first">
      <SimpleText
        class:list={["eyebrow", "reveal", "reveal-slide-up", "delay-100"]}
        data-prop="eyebrow"
        text={eyebrow}
      />
      <Heading
        level="h1"
        size="2xl"
        class="reveal reveal-slide-up delay-200"
        data-prop="heading"
        >{heading}</Heading
      >
      <Text
        class:list={["subtext", "reveal", "reveal-slide-up", "delay-300"]}
        data-prop="subtext"
        text={subtext}
      />
      <ButtonGroup
        class:list={["buttons-container", "reveal", "reveal-slide-up", "delay-400"]}
        buttonSections={buttonSections}
        data-children-prop="buttonSections"
      />
    </Fragment>
    <Fragment slot="second">
      {
        videoSource ? (
          <video
            autoplay
            muted
            loop
            playsinline
            controls
            crossorigin="anonymous"
            class="hero-video reveal reveal-zoom-in delay-300"
            style="width: 100%; border-radius: var(--radius-xl); overflow: hidden; display: block; box-shadow: var(--shadow-lg);"
            data-prop="videoSource"
          >
            <source src={videoSource} type="video/mp4" />
          </video>
        ) : (
          <Image
            source={imageSource}
            alt={imageAlt}
            rounded={true}
            aspectRatio={imageAspectRatio}
            data-prop-src="imageSource"
            data-prop-alt="imageAlt"
            priority={true}
            class="reveal reveal-zoom-in delay-300"
          />
        )
      }
    </Fragment>
  </Split>
</CustomSection>
