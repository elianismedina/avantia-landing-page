---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import Split from "@wrappers/split/Split.astro";

const {
  eyebrow = "",
  heading = "",
  subtext = "",
  buttonSections = [],
  imageSource = "",
  imageAlt = "",
  videoSource = "",
  imageAspectRatio = "portrait",
  imageRounded = true,
  reverse = false,
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "lg",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  backgroundColor,
  background,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const minSplitWidth = 800;
const featureSplitId = `feature-split-${crypto.randomUUID()}`;
---

<CustomSection
  class:list={["feature-split", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  background={background}
  data-feature-split-id={featureSplitId}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <Split
    class="feature-split-layout"
    distributionMode="flexible-fixed"
    fixedWidth="400"
    minSplitWidth={minSplitWidth}
    reverse={reverse}
    alignmentVertical="center"
    gap="2xl"
    reverseOrderOnMobile={true}
  >
    <Fragment slot="first">
      <SimpleText
        class="eyebrow"
        data-prop="eyebrow"
        text={eyebrow}
      />
      <Heading
        level="h2"
        size="lg"
        data-prop="heading"
      >
        {heading}
      </Heading>
      <Text
        class="subtext"
        data-prop="subtext"
        text={subtext}
      />
      <ButtonGroup
        class="feature-buttons"
        buttonSections={buttonSections}
        direction="row"
        alignmentHorizontal="start"
        data-children-prop="buttonSections"
      />
    </Fragment>
    {
      videoSource ? (
        <video
          slot="second"
          class:list={[
            "feature-split-image",
            reverse && "reverse",
            imageRounded && "rounded",
          ]}
          autoplay
          muted
          loop
          playsinline
          controls
          style={`aspect-ratio: ${imageAspectRatio === 'video' ? '16/9' : imageAspectRatio === 'square' ? '1/1' : '16/9'}; width: 100%; border-radius: var(--radius-xl); overflow: hidden; display: block; box-shadow: var(--shadow-lg); object-fit: cover;`}
          data-prop="videoSource"
        >
          <source src={videoSource} type="video/mp4" />
        </video>
      ) : (
        <Image
          slot="second"
          class:list={["feature-split-image", reverse && "reverse"]}
          source={imageSource}
          alt={imageAlt}
          rounded={imageRounded}
          aspectRatio={imageAspectRatio}
          data-prop-src="imageSource"
          data-prop-alt="imageAlt"
        />
      )
    }
  </Split>
</CustomSection>

{
  !videoSource && imageAspectRatio == "portrait" && (
    <style
      is:inline
      set:html={`
        @container feature-split-layout (min-width: ${minSplitWidth}px) {
        .feature-split-image.image.rounded.reverse {
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
        }
        .feature-split-image.image.rounded:not(.reverse) {
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
        }
        }
    `}
    />
  )
}

<style is:global>
  @layer page-sections {
    .feature-split-layout {
      container-type: inline-size;
    }
  }
</style>
