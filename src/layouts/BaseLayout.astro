---
import { ClientRouter } from "astro:transitions";
import { fade } from "astro:transitions";
import SeoHead from "@components/utils/SeoHead.astro";
import StructuredData from "@components/utils/StructuredData.astro";
import seoData from "@data/seo.json";
import "@styles/style.css";
import SiteFonts from "@layouts/SiteFonts.astro";
import VideoElements from "@components/utils/VideoElements.astro";

export interface Props {
  title: string;
  description?: string | null;
  keywords?: string[] | null;
  image?: string | null;
  canonical?: string | null;
  type?: "website" | "article";
  article?: {
    publishedTime?: string | null;
    modifiedTime?: string | null;
    author?: string | string[] | null;
    tags?: string[] | null;
  } | null;
  noindex?: boolean;
  schemaData?: Record<string, any>[] | Record<string, any> | null;
}

const props = Astro.props;
---

<!doctype html>
<html
  lang="es"
  data-theme="light"
>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <style is:inline>
      @layer reset, base, components, page-sections, utils, overrides;
    </style>

    <SiteFonts />

    {
      import.meta.env.DEV ? (
        <script
          type="module"
          src="/@vite/client"
        />
      ) : null
    }



    <SeoHead
      site={seoData}
      title={props.title}
      description={props.description}
      keywords={props.keywords}
      image={props.image}
      canonical={props.canonical}
      type={props.type}
      article={props.article}
      noindex={props.noindex}
    />

    <StructuredData site={seoData} />

    {
      props.schemaData && (Array.isArray(props.schemaData) ? props.schemaData : [props.schemaData]).map((schema) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(schema)}
        />
      ))
    }

    <link
      rel="sitemap"
      type="application/xml"
      title="Sitemap"
      href="/sitemap-index.xml"
    />

    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <div transition:animate={fade({ duration: "0.2s" })}>
      <slot />
    </div>
    <VideoElements />

    <script>
      import { onPageLoad } from "@component-utils/onPageLoad";

      function initScrollReveal() {
        const revealElements = document.querySelectorAll(".reveal:not(.reveal .reveal)");
        if (revealElements.length === 0) return;

        const observerOptions = {
          root: null,
          rootMargin: "0px 0px -10% 0px", // Triggers when element is 10% inside viewport from the bottom
          threshold: 0.05,
        };

        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const target = entry.target as HTMLElement;
              target.classList.add("is-visible");
              obs.unobserve(target); // Only animate once
            }
          });
        }, observerOptions);

        revealElements.forEach((el) => {
          // If it's already in viewport or has .animate-now class, show it immediately
          if (el.classList.contains("animate-now")) {
            el.classList.add("is-visible");
          } else {
            observer.observe(el);
          }
        });
      }

      onPageLoad(initScrollReveal);
    </script>
  </body>
</html>
